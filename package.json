{
  "name": "saucedemo-automation",
  "version": "1.0.0",
  "description": "BDD browser automation for SauceDemo using Playwright, Cucumber, and Allure",
  "scripts": {
    "test": "cucumber-js",
    "test:bdd": "cucumber-js",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:regression": "cucumber-js --tags @regression",
    "test:report": "npm test && npm run allure:generate",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.12.2",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.4",
    "playwright": "^1.63.0"
  }
}
